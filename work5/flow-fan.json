    "y": 80,
    "wires": []
  },
  {
    "id": "sw_temp",
    "type": "switch",
    "z": "tab_smart_office",
    "name": "TEMP > 30 C",
    "property": "tempValue",
    "propertyType": "msg",
    "rules": [
      {
        "t": "gt",
        "v": "30",
        "vt": "num"
      },
      {
        "t": "else"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 640,
    "y": 220,
    "wires": [
      [
        "chg_fan_on"
      ],
      [
        "chg_fan_off"
      ]
    ]
  },
  {
