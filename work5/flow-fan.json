[
  {
    "id": "tab_smart_office",
    "type": "tab",
    "label": "Умный офис: датчики и вентилятор",
    "disabled": false,
    "info": "TEMP-01 и HUM-01 каждые 5 с отправляют показания на CTRL. Отдельные change-узлы FAN ON и FAN OFF: больше 30 C — ON, иначе OFF; запрос идёт на /api/actuators."
  },
  {
    "id": "inj_temp",
    "type": "inject",
    "z": "tab_smart_office",
    "name": "TEMP-01: 18-35 C каждые 5 с",
    "props": [
      {
        "p": "payload",
        "v": "23",
        "vt": "jsonata"
      },
      {
        "p": "topic",
        "vt": "str"
      }
    ],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "TEMP-01",
    "payload": "23",
    "payloadType": "jsonata",
    "x": 130,
    "y": 80,
    "wires": [
      [
        "chg_temp_value"
      ]
    ]
  },
  {
    "id": "inj_test_hot",
    "type": "inject",
    "z": "tab_smart_office",
    "name": "ТЕСТ: 33 C (нажать)",
    "props": [
      {
        "p": "payload",
        "v": "33",
        "vt": "jsonata"
      },
      {
        "p": "topic",
        "v": "TEMP-01",
        "vt": "str"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 130,
    "y": 150,
    "wires": [
      [
        "chg_temp_value"
      ]
    ]
  },
  {
    "id": "chg_temp_value",
    "type": "change",
    "z": "tab_smart_office",
    "name": "TEMP-01: значение и время",
    "rules": [
      {
        "t": "set",
        "p": "tempValue",
        "pt": "msg",
        "to": "payload",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "timestamp",
        "pt": "msg",
        "to": "$millis()",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 400,
    "y": 80,
    "wires": [
      [
        "chg_temp_reading",
        "sw_temp"
      ]
    ]
  },
  {
    "id": "chg_temp_reading",
    "type": "change",
    "z": "tab_smart_office",
    "name": "Чтение TEMP-01 -> payload",
    "rules": [
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "{\"sensor_id\":\"TEMP-01\",\"zone\":\"server_room\",\"unit\":\"C\",\"value\":tempValue,\"timestamp\":timestamp}",
        "tot": "jsonata"
      },
      {
        "t": "set",
        "p": "headers",
        "pt": "msg",
        "to": "{\"Content-Type\":\"application/json\"}",
        "tot": "json"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 660,
    "y": 80,
    "wires": [
      [
        "http_temp"
      ]
    ]
  },
  {
    "id": "http_temp",
    "type": "http request",
    "z": "tab_smart_office",
    "name": "POST TEMP-01 -> /api/readings",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "http://192.168.20.10:8080/api/readings",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 930,
    "y": 80,
    "wires": [
      [
        "dbg_temp"
      ]
    ]
  },
  {
    "id": "dbg_temp",
    "type": "debug",
    "z": "tab_smart_office",
    "name": "Ответ приёмника: TEMP-01",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
